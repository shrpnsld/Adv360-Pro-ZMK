#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        tmux_cmd: tmux_cmd {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LC(B) &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TMUX_CMD";
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;

            hold-trigger-on-release;
            quick-tap-ms = <100>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE   &kp N1          &kp N2            &kp N3          &kp N4                &kp N5  &kp K_CONTEXT_MENU                                                                            &mo 2         &kp N6  &kp N7                 &kp N8           &kp N9             &kp N0          &kp BACKSLASH
&kp EQUAL   &kp Q           &kp W             &kp E           &kp R                 &kp T   &bt BT_SEL 0                                                                                  &bt BT_SEL 2  &kp Y   &kp U                  &kp I            &kp O              &kp P           &kp MINUS
&kp ESCAPE  &kp A           &kp S             &kp D           &kp F                 &kp G   &bt BT_SEL 1        &kp LEFT_CONTROL  &kp LEFT_COMMAND      &kp RIGHT_COMMAND  &kp RIGHT_ALT  &bt BT_SEL 3  &kp H   &kp J                  &kp K            &kp L              &kp SEMI        &kp SQT
&kp LSHFT   &kp Z           &kp X             &kp C           &kp V                 &kp B                                         &kp HOME              &kp PAGE_UP                                     &kp N   &kp M                  &kp COMMA        &kp DOT            &kp FSLH        &kp RSHFT
&mo 1       &kp UNDERSCORE  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS          &kp BSPC            &kp TAB           &kp END               &kp PAGE_DOWN      &kp ENTER      &kp SPACE             &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp UNDERSCORE  &mo 1
            >;
        };

        fn {
            bindings = <
&kp F11  &kp F1  &kp F2        &kp F3        &kp F4        &kp F5  &none                                           &mo 0             &kp F6          &kp F7                &kp F8                &kp F9             &kp F10                  &kp F12
&trans   &trans  &kp N7        &kp N8        &kp N9        &trans  &none                                           &none             &tmux_cmd Y     &tmux_cmd U           &tmux_cmd I           &tmux_cmd O        &tmux_cmd P              &trans
&trans   &kp N0  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans  &none       &trans  &trans      &trans  &trans  &none             &kp LEFT_ARROW  &kp DOWN_ARROW        &kp UP_ARROW          &kp RIGHT_ARROW    &tmux_cmd RIGHT_BRACKET  &tmux_cmd X
&mo 3    &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans                      &trans      &trans                            &kp HOME        &kp PAGE_DOWN         &kp PAGE_UP           &kp END            &tmux_cmd LEFT_BRACKET   &mo 3
&trans   &trans  &trans        &kp C_PREV    &kp C_NEXT            &kp DELETE  &trans  &trans      &trans  &trans  &kp C_PLAY_PAUSE                  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP          &trans
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &macro_ver    &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_DEC  &bl BL_INC  &none  &none  &none
            >;
        };

        fn+shift {
            bindings = <
&kp LS(F11)  &kp LS(F1)  &kp LS(F2)  &kp LS(F3)  &kp LS(F4)  &kp LS(F5)  &none                                       &mo 0   &kp LS(F6)  &kp LS(F7)             &kp LS(F8)            &kp LS(F9)  &kp LS(F10)  &kp LS(F12)
&trans       &trans      &trans      &trans      &trans      &trans      &none                                       &none   &trans      &trans                 &trans                &trans      &trans       &trans
&trans       &trans      &trans      &trans      &trans      &trans      &none   &trans  &trans      &trans  &trans  &none   &trans      &tmux_cmd RIGHT_BRACE  &tmux_cmd LEFT_BRACE  &trans      &trans       &tmux_cmd LS(X)
&trans       &trans      &trans      &trans      &trans      &trans                      &trans      &trans                  &trans      &trans                 &trans                &trans      &trans       &trans
&trans       &trans      &trans      &trans      &trans                  &trans  &trans  &trans      &trans  &trans  &trans              &trans                 &trans                &trans      &trans       &trans
            >;
        };
    };
};
